// ====================================================================
// 主應用程式入口點 - 結構化版本
//
// 📁 專案架構說明：
// lib/
// ├── main.dart                      # 主程式入口點
// ├── core/                          # 核心功能
// │   ├── theme/                     # 主題設定
// │   └── utils/                     # 通用工具
// ├── data/                          # 資料層
// │   ├── models/                    # 資料模型
// │   │   ├── container_analysis.dart
// │   │   ├── measurement.dart 
// │   │   └── nutrition.dart
// │   └── services/                  # 服務層
// │       ├── reference_database.dart
// │       ├── measurement_calculator.dart
// │       └── log_manager.dart
// └── features/                      # 功能模組(Feature-First)
//     ├── auth/                      # 登入認證功能
//     ├── home/                      # 首頁功能
//     ├── analysis/                  # 身體分析功能
//     ├── food_diary/                # 飲食日記功能
//     └── camera/                    # 相機功能
//
// ✅ 本專案採用 Feature-First 架構：
// - 功能模組化：各模組獨立開發與維護
// - 團隊協作：可同時開發不同功能
// - 易於擴展：新增功能不影響現有程式碼
// - 測試友好：方便進行單元測試
// - 符合 Clean Architecture
// ====================================================================
// ====================================================================
