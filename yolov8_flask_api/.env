# Gemini API 設定
GEMINI_API_KEY=AIzaSyCMBtYrsRUqksBZtJUUcf5vO6GbzwN9CwE

# Firebase 設定
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Flask 設定
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 日誌設定
LOG_LEVEL=INFO
LOG_FILE=app.log

# YOLO 模型設定
YOLO_MODEL_PATH=初試v2.pt
YOLO_CLASSES_PATH=classes.txt

# LM Studio 本地 API 設定（備援 LLM）
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL=gemma-3-4b-it

# 翻譯器設定（用於 Gemma 3 視覺模型的中文化）
TRANSLATOR_MODEL=llama-breeze2-8b-instruct-text
ENABLE_AUTO_TRANSLATION=true
